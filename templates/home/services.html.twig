{% extends 'base.html.twig' %}

{% block title %}Truno Beauty Salon · Services{% endblock %}

{% block body %}
<section id="services_section" class="scroll-mt-16 section-reveal">
    <!-- Services Page Header -->
    <section class="bg-[#FAF1D6] py-8 text-center border-b border-[#C68E00]/20">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-[#C68E00] tracking-wide">Services</h1>
    </section>

    <!-- Wide Hero Banner Image -->
    <section class="relative w-full">
        <img src="{{ asset('images/makeup.webp') }}"
             alt="Services Banner"
             class="w-full h-auto object-cover block">
    </section>

    <!-- Services and Prices Main Container -->
    <section class="bg-[#FAF1D6] py-16 px-4">
        <div class="max-w-6xl mx-auto text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-heading font-bold text-[#C68E00] mb-3">Services and prices</h2>
            <p class="text-gray-700 text-sm md:text-base max-w-xl mx-auto">
                Transparent pricing and exceptional service—discover the perfect pampering experience tailored just for you.
            </p>
        </div>

        <div class="max-w-6xl mx-auto space-y-20">
            {% for cat in categories %}
                {% set isEven = loop.index0 is even %}

                <!-- Category Row -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center reveal-on-scroll">
                    {% if isEven %}
                        <!-- Image Left -->
                        <div class="w-full h-[360px] md:h-[420px] rounded-2xl overflow-hidden shadow-md">
                            <img src="{{ asset(cat.image) }}" loading="lazy" decoding="async" alt="{{ cat.name }}" class="w-full h-full object-cover">
                        </div>
                    {% endif %}

                    <!-- Content Right / Left -->
                    <div class="flex flex-col justify-center space-y-4">
                        <h3 class="text-3xl font-heading font-bold text-[#C68E00]">{{ cat.name }}</h3>
                        <p class="text-gray-700 text-sm leading-relaxed max-w-md">{{ cat.description }}</p>

                        <!-- Dotted Leader List -->
                        <div class="space-y-3 max-w-md pt-2">
                            {% for item in cat.items %}
                                <div class="flex items-baseline justify-between text-gray-800">
                                    <span class="font-heading font-semibold text-base text-neutral-800">{{ item.name }}</span>
                                    <span class="flex-1 border-b border-dotted border-[#C68E00]/60 mx-3"></span>
                                    <span class="text-gray-600 text-xs md:text-sm whitespace-nowrap">
                                        from <span class="font-bold text-[#C68E00]">₱{{ item.price|number_format }}</span>
                                    </span>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="pt-4">
                            <a href="#book-appointment" class="inline-block text-[#C68E00] font-heading font-semibold text-sm underline hover:text-black transition-colors">
                                View all
                            </a>
                        </div>
                    </div>

                    {% if not isEven %}
                        <!-- Image Right -->
                        <div class="w-full h-[360px] md:h-[420px] rounded-2xl overflow-hidden shadow-md">
                            <img src="{{ asset(cat.image) }}" loading="lazy" decoding="async" alt="{{ cat.name }}" class="w-full h-full object-cover">
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        <!-- Embedded Book Appointment Card -->
        <div id="book-appointment" class="max-w-5xl mx-auto mt-24 bg-white rounded-3xl p-6 md:p-8 shadow-lg overflow-hidden border border-amber-100 reveal-on-scroll">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-0 rounded-2xl overflow-hidden">
                <!-- Left Side Portrait Image -->
                <div class="md:col-span-5 h-[350px] md:h-auto min-h-[450px]">
                    <img src="{{ asset('images/df.webp') }}"
                         loading="lazy" decoding="async"
                         alt="Beauty Salon Glamour"
                         class="w-full h-full object-cover">
                </div>

                <!-- Right Side Interactive Booking Form -->
                <div class="md:col-span-7 bg-[#FAF1D6]/80 p-6 md:p-10 flex flex-col justify-center">
                    <span class="text-xs uppercase tracking-wider text-[#C68E00] font-bold font-heading mb-1">BEAUTY SALON</span>
                    <h2 class="text-3xl font-heading font-bold text-black mb-2">Book appointment</h2>
                    <p class="text-gray-600 text-xs md:text-sm mb-6">Fill out the details below to schedule your visit and secure your preferred time.</p>

                    <form action="{{ path('app_services') }}" method="POST" class="space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('book_appointment') }}">
                        <input type="hidden" name="action" value="book_appointment">

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">First name</label>
                                <input type="text" name="first_name" required placeholder="First name"
                                       class="w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:border-[#C68E00]">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">Last name</label>
                                <input type="text" name="last_name" required placeholder="Last name"
                                       class="w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:border-[#C68E00]">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">Email</label>
                                <input type="email" name="email" required placeholder="Email"
                                       class="w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:border-[#C68E00]">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">Phone</label>
                                <input type="tel" name="phone" required placeholder="Phone"
                                       class="w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:border-[#C68E00]">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">Date</label>
                                <input type="date" name="appointment_date" required value="{{ 'now'|date('Y-m-d') }}"
                                       class="w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:border-[#C68E00]">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">Time</label>
                                <input type="time" name="start_time" required value="10:30"
                                       class="w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:border-[#C68E00]">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1">Service</label>
                            <select name="service_id" required
                                    class="w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:border-[#C68E00]">
                                <option value="">Select Service</option>
                                {% for s in allServices %}
                                    <option value="{{ s.id }}">{{ s.name }} (₱{{ s.price|number_format }})</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="pt-2">
                            <button type="submit" class="w-full bg-[#C68E00] hover:bg-[#A37500] text-white font-heading font-bold text-sm py-3 rounded-md transition-colors shadow-md">
                                Send message
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</section>
{% endblock %}

