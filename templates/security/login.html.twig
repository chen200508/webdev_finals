{% extends 'base.html.twig' %}

{% block title %}Truno Beauty Salon · Sign In{% endblock %}

{% block footer %}{% endblock %}

{% block body %}
<section class="relative bg-[#FBF4DE] py-12 md:py-16 px-4 flex items-center justify-center min-h-[calc(100vh-5rem)] overflow-hidden">
    <!-- Background Image with Lower Opacity -->
    <img
        src="{{ asset('images/hero.webp') }}"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none select-none"
    >
    <div class="absolute inset-0 bg-[#FBF4DE]/50 pointer-events-none"></div>

    <!-- Main Card Container -->
    <div class="relative z-10 w-full max-w-4xl bg-white rounded-3xl shadow-2xl border border-[#C68E00]/25 overflow-hidden grid grid-cols-1 md:grid-cols-2">
        <!-- Left Image Panel (Hidden on Mobile) -->
        <div class="hidden md:block relative min-h-[520px]">
            <img
                src="{{ asset('images/Studio.webp') }}"
                alt="Truno Beauty Salon Studio"
                class="absolute inset-0 w-full h-full object-cover"
            >
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-8 text-white">
                <span class="text-xs uppercase tracking-[0.25em] text-[#FBF4DE] font-heading font-semibold mb-1">S Beauty Salon</span>
                <h2 class="text-2xl font-heading font-bold leading-snug">Elegance comes from being as beautiful inside as outside</h2>
            </div>
        </div>

        <!-- Right Form Panel -->
        <div class="p-8 md:p-10 lg:p-12 flex flex-col justify-center">
            <div class="text-center md:text-left mb-8">
                <span class="text-xs uppercase tracking-widest text-[#C68E00] font-bold font-heading">Welcome Back</span>
                <h1 class="h3 text-3xl font-heading font-bold text-gray-900 mt-1">Please sign in</h1>
                <p class="text-xs text-gray-500 mt-2">Enter your credentials to access your account</p>
            </div>

            <form method="post" class="space-y-5">
                {% if error %}
                    <div class="alert alert-danger rounded-xl bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 text-xs font-semibold flex items-center gap-2">
                        <i class="ti ti-alert-circle text-base"></i>
                        <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3 rounded-xl bg-amber-50 border border-[#C68E00]/30 text-gray-800 px-4 py-3 text-xs flex items-center justify-between">
                        <span>You are logged in as <strong>{{ app.user.userIdentifier }}</strong></span>
                        <a href="{{ logout_path() }}" class="text-[#C68E00] font-bold underline hover:text-black">Logout</a>
                    </div>
                {% endif %}

                <div>
                    <label for="inputEmail" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Email</label>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="email"
                        id="inputEmail"
                        class="form-control w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:border-[#C68E00] focus:ring-2 focus:ring-[#C68E00]/20 outline-none text-sm text-gray-800"
                        autocomplete="email"
                        placeholder="e.g. example@email.com"
                        required
                        autofocus
                    >
                </div>

                <div>
                    <label for="inputPassword" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Password</label>
                    <div class="relative">
                        <input
                            type="password"
                            name="password"
                            id="inputPassword"
                            class="form-control w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:border-[#C68E00] focus:ring-2 focus:ring-[#C68E00]/20 outline-none text-sm text-gray-800 pr-14"
                            autocomplete="current-password"
                            placeholder="••••••••"
                            required
                        >
                        <button
                            type="button"
                            data-password-toggle="inputPassword"
                            aria-label="Show password"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-[#C68E00] hover:text-black"
                        >
                            Show
                        </button>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <div class="checkbox flex items-center justify-between text-xs text-gray-600">
                    <label class="inline-flex items-center gap-2 cursor-pointer select-none">
                        <input type="checkbox" name="_remember_me" class="rounded border-gray-300 text-[#C68E00] focus:ring-[#C68E00]">
                        <span>Remember me</span>
                    </label>
                </div>

                <button class="btn btn-lg btn-primary w-full bg-[#C68E00] hover:bg-[#a87700] text-white font-heading font-bold text-sm py-3 px-6 rounded-xl transition-colors shadow-md cursor-pointer" type="submit">
                    Sign in
                </button>

                <p class="text-center text-xs text-gray-600 pt-2">
                    Don't have an account?
                    <a href="{{ path('app_register') }}" class="text-[#C68E00] font-heading font-bold underline hover:text-black">Register</a>
                </p>
            </form>
        </div>
    </div>
</section>
{% endblock %}
