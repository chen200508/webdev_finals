{% extends 'dashboard/layout.html.twig' %}

{% block title %}Overview · S Beauty Salon{% endblock %}

{% block styles %}
    .kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 24px 0; }
    .kpi {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 22px;
        background: var(--card-bg);
        color: var(--main-text);
        border: 1px solid var(--card-border);
        border-radius: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,.02);
    }
    .kpi-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .kpi-label { color: #C68E00; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; font-weight: 700; font-family: var(--font-admin); }
    .kpi-icon {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(198, 142, 0, 0.14);
        border: 1px solid rgba(198, 142, 0, 0.3);
        color: #C68E00;
        font-size: 22px;
        flex-shrink: 0;
    }
    .kpi strong { display: block; margin: 8px 0 4px; font-size: 30px; line-height: 1; color: var(--main-text); }
    .kpi-desc { margin: 0 0 16px; color: var(--main-sub); font-size: 13px; font-family: var(--font-admin); }
    .kpi-action { display: inline-flex; align-items: center; justify-content: center; gap: 6px; align-self: flex-start; background: #C68E00; color: #fff; border-radius: 10px; padding: 8px 14px; font-size: 13px; font-weight: 700; font-family: var(--font-admin); transition: background .15s; }
    .kpi-action:hover { background: #a87700; }
    .overview-grid { display: grid; grid-template-columns: 1fr; gap: 22px; margin-top: 24px; }
    .overview-split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
    .chart-box { position: relative; width: 100%; height: 260px; display: flex; align-items: center; justify-content: center; }
    .card { display: flex; flex-direction: column; justify-content: space-between; margin-top: 0; }
    .card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .card-head-title { display: flex; align-items: center; gap: 12px; }
    .card-head-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(198, 142, 0, 0.14);
        border: 1px solid rgba(198, 142, 0, 0.3);
        color: #C68E00;
        font-size: 20px;
        flex-shrink: 0;
    }
    .card-head h2 { margin: 0; font-size: 18px; color: var(--main-text); }
    .card-sub { margin: 2px 0 0; color: var(--main-sub); font-size: 12px; font-family: var(--font-admin); }
    .btn-link { display: inline-flex; align-items: center; gap: 6px; background: #1c140c; color: #D49A26; border: 1px solid #C68E00; border-radius: 10px; padding: 7px 14px; font-size: 13px; font-weight: 700; font-family: var(--font-admin); transition: all .15s; }
    .btn-link:hover { background: #C68E00; color: #fff; }
    th { padding: 10px 12px; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
    td { padding: 12px; }
    .badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; font-family: var(--font-admin); }
    .badge-1 { background: #fef3c7; color: #92400e; }
    .badge-2 { background: #dbeafe; color: #1e40af; }
    .badge-3 { background: #dcfce7; color: #166534; }
    .badge-4 { background: #fee2e2; color: #991b1b; }
    @media (max-width: 900px) {
        .kpis, .overview-split { grid-template-columns: 1fr; }
    }
{% endblock %}

{% block content %}
    {% set statuses = {1: 'Pending', 2: 'Confirmed', 3: 'Completed', 4: 'Cancelled'} %}
    {% set staffMap = {} %}
    {% for member in staff|default([]) %}
        {% set staffMap = staffMap|merge({('s_' ~ member.id): (member.first_name ~ ' ' ~ member.last_name)|trim}) %}
    {% endfor %}

    {# Compute status counts and top services for Chart.js #}
    {% set pendingCount = appointments|filter(a => (a.status_id ?? 1) == 1)|length %}
    {% set confirmedCount = appointments|filter(a => (a.status_id ?? 1) == 2)|length %}
    {% set completedCount = appointments|filter(a => (a.status_id ?? 1) == 3)|length %}
    {% set cancelledCount = appointments|filter(a => (a.status_id ?? 1) == 4)|length %}
    {% set chartServices = services|slice(0, 6) %}

    <div id="overview">
        <h1>Overview</h1>
        <p class="lede">Summary of appointments, service catalog, and client records for S Beauty Salon.</p>

        <div class="kpis">
            <article class="kpi">
                <div>
                    <div class="kpi-top">
                        <span class="kpi-label">Appointments</span>
                        <span class="kpi-icon" aria-hidden="true"><i class="ti ti-calendar-event"></i></span>
                    </div>
                    <strong>{{ counts.bookings ?? appointments|length }}</strong>
                    <p class="kpi-desc">Scheduled client bookings across all salon artists.</p>
                </div>
                <a class="kpi-action" href="{{ path('admin_appointments') }}">
                    <span>Manage Appointments</span>
                    <i class="ti ti-arrow-right"></i>
                </a>
            </article>

            <article class="kpi">
                <div>
                    <div class="kpi-top">
                        <span class="kpi-label">Services</span>
                        <span class="kpi-icon" aria-hidden="true"><i class="ti ti-scissors"></i></span>
                    </div>
                    <strong>{{ counts.services ?? services|length }}</strong>
                    <p class="kpi-desc">Active treatments and packages in the salon catalog.</p>
                </div>
                <a class="kpi-action" href="{{ path('admin_services') }}">
                    <span>Manage Services</span>
                    <i class="ti ti-arrow-right"></i>
                </a>
            </article>

            <article class="kpi">
                <div>
                    <div class="kpi-top">
                        <span class="kpi-label">Customers</span>
                        <span class="kpi-icon" aria-hidden="true"><i class="ti ti-users"></i></span>
                    </div>
                    <strong>{{ counts.clients ?? customers|length }}</strong>
                    <p class="kpi-desc">Registered clients with contact and booking history.</p>
                </div>
                <a class="kpi-action" href="{{ path('admin_customers') }}">
                    <span>View Customers</span>
                    <i class="ti ti-arrow-right"></i>
                </a>
            </article>
        </div>

        <div class="overview-grid">
            {# Analytics Charts Section #}
            <div class="overview-split">
                <section class="card">
                    <div class="card-head">
                        <div class="card-head-title">
                            <span class="card-head-icon" aria-hidden="true"><i class="ti ti-chart-pie"></i></span>
                            <div>
                                <h2>Appointments by Status</h2>
                                <p class="card-sub">Breakdown of pending, confirmed, completed, and cancelled bookings.</p>
                            </div>
                        </div>
                    </div>
                    <div class="chart-box">
                        <canvas id="statusChart" aria-label="Appointments by Status Pie Chart" role="img"></canvas>
                    </div>
                </section>

                <section class="card">
                    <div class="card-head">
                        <div class="card-head-title">
                            <span class="card-head-icon" aria-hidden="true"><i class="ti ti-chart-bar"></i></span>
                            <div>
                                <h2>Service Pricing &amp; Revenue</h2>
                                <p class="card-sub">Comparison of catalog prices (₱) across salon treatments.</p>
                            </div>
                        </div>
                    </div>
                    <div class="chart-box">
                        <canvas id="serviceChart" aria-label="Service Pricing Chart" role="img"></canvas>
                    </div>
                </section>
            </div>

            <section class="card">
                <div class="card-head">
                    <div class="card-head-title">
                        <span class="card-head-icon" aria-hidden="true"><i class="ti ti-calendar-clock"></i></span>
                        <div>
                            <h2>Recent Appointments</h2>
                            <p class="card-sub">Quick preview of upcoming and recent studio bookings.</p>
                        </div>
                    </div>
                    <a class="btn-link" href="{{ path('admin_appointments') }}">
                        <span>View all appointments</span>
                        <i class="ti ti-arrow-right"></i>
                    </a>
                </div>
                <div style="overflow-x: auto;">
                    <table>
                        <thead>
                            <tr>
                                <th>Date &amp; Time</th>
                                <th>Client</th>
                                <th>Service</th>
                                <th>Artist</th>
                                <th>Price</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for appointment in appointments|slice(0, 4) %}
                                <tr>
                                    <td>{{ appointment.appointment_date|date('M j, Y') }} {{ appointment.start_time|date('g:i A') }}</td>
                                    <td>{{ appointment.customer_name }} ({{ appointment.email }})</td>
                                    <td>{{ appointment.service_name }}</td>
                                    <td>{{ appointment.staff_name|default(staffMap['s_' ~ appointment.staff_id] ?? ('Staff #' ~ appointment.staff_id)) }}</td>
                                    <td>₱{{ appointment.price }}</td>
                                    <td>{{ statuses[appointment.status_id] ?? 'Pending' }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6">No appointments scheduled yet.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            <div class="overview-split">
                <section class="card">
                    <div>
                        <div class="card-head">
                            <div class="card-head-title">
                                <span class="card-head-icon" aria-hidden="true"><i class="ti ti-list-details"></i></span>
                                <div>
                                    <h2>Service Catalog</h2>
                                    <p class="card-sub">Featured treatments and pricing.</p>
                                </div>
                            </div>
                            <a class="btn-link" href="{{ path('admin_services') }}">
                                <span>Full catalog</span>
                                <i class="ti ti-arrow-right"></i>
                            </a>
                        </div>
                        <div style="overflow-x: auto;">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Service</th>
                                        <th>Duration</th>
                                        <th>Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for service in services|slice(0, 4) %}
                                        <tr>
                                            <td>{{ service.name }} ({{ service.category_name }})</td>
                                            <td>{{ service.duration_minutes }} mins</td>
                                            <td>₱{{ service.price }}</td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="3">No services available.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section class="card">
                    <div>
                        <div class="card-head">
                            <div class="card-head-title">
                                <span class="card-head-icon" aria-hidden="true"><i class="ti ti-address-book"></i></span>
                                <div>
                                    <h2>Recent Customers</h2>
                                    <p class="card-sub">Clients registered at the studio.</p>
                                </div>
                            </div>
                            <a class="btn-link" href="{{ path('admin_customers') }}">
                                <span>All customers</span>
                                <i class="ti ti-arrow-right"></i>
                            </a>
                        </div>
                        <div style="overflow-x: auto;">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Client</th>
                                        <th>Phone</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for customer in customers|slice(0, 4) %}
                                        {% set customerName = customer.name is defined ? customer.name : (customer.customer_name is defined ? customer.customer_name : ((customer.first_name ?? '') ~ ' ' ~ (customer.last_name ?? ''))|trim) %}
                                        <tr>
                                            <td>{{ customerName }}{% if customer.email is defined and customer.email %} ({{ customer.email }}){% endif %}</td>
                                            <td>{{ customer.phone ?? '' }}</td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="2">No customers yet.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {% set pendingCount = appointments|filter(a => (a.status_id ?? 1) == 1)|length %}
    {% set confirmedCount = appointments|filter(a => (a.status_id ?? 1) == 2)|length %}
    {% set completedCount = appointments|filter(a => (a.status_id ?? 1) == 3)|length %}
    {% set cancelledCount = appointments|filter(a => (a.status_id ?? 1) == 4)|length %}
    {% set chartServices = services|slice(0, 6) %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof Chart === 'undefined') return;

            const statusData = [
                {{ pendingCount }},
                {{ confirmedCount }},
                {{ completedCount }},
                {{ cancelledCount }}
            ];
            const statusLabels = [
                'Pending (' + statusData[0] + ')',
                'Confirmed (' + statusData[1] + ')',
                'Completed (' + statusData[2] + ')',
                'Cancelled (' + statusData[3] + ')'
            ];

            const serviceLabels = [
                {% for service in chartServices %}
                    {{ service.name|json_encode|raw }}{% if not loop.last %},{% endif %}
                {% endfor %}
            ];
            const servicePrices = [
                {% for service in chartServices %}
                    {{ service.price ?? 0 }}{% if not loop.last %},{% endif %}
                {% endfor %}
            ];

            function getThemeColors() {
                const isDark = document.body.getAttribute('data-theme') === 'dark';
                return {
                    textColor: isDark ? '#f5efe6' : '#1f2937',
                    mutedColor: isDark ? '#a89f91' : '#6b7280',
                    gridColor: isDark ? '#374151' : '#e5e7eb',
                    sliceBorderColor: isDark ? '#374151' : '#ffffff'
                };
            }

            let colors = getThemeColors();

            const pieValueLabelsPlugin = {
                id: 'pieValueLabels',
                afterDatasetsDraw(chart) {
                    const { ctx } = chart;
                    const dataset = chart.data.datasets[0];
                    if (!dataset) return;
                    const total = dataset.data.reduce((sum, val) => sum + Number(val || 0), 0);
                    if (total <= 0) return;

                    const meta = chart.getDatasetMeta(0);
                    ctx.save();
                    ctx.font = '700 12px "Metropolis", sans-serif';
                    ctx.fillStyle = '#ffffff';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';

                    meta.data.forEach((arc, index) => {
                        const value = Number(dataset.data[index] || 0);
                        if (value <= 0) return;
                        const pct = Math.round((value / total) * 100);
                        const pos = arc.tooltipPosition();
                        ctx.fillText(value + ' (' + pct + '%)', pos.x, pos.y);
                    });
                    ctx.restore();
                }
            };

            const statusCtx = document.getElementById('statusChart');
            const statusChart = statusCtx ? new Chart(statusCtx, {
                type: 'pie',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusData,
                        backgroundColor: ['#f59e0b', '#3b82f6', '#10b981', '#ef4444'],
                        borderColor: colors.sliceBorderColor,
                        borderWidth: 2,
                        hoverOffset: 6
                    }]
                },
                plugins: [pieValueLabelsPlugin],
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: colors.textColor,
                                padding: 16,
                                usePointStyle: true,
                                font: { family: '"Metropolis", sans-serif', size: 12, weight: '600' }
                            }
                        }
                    }
                }
            }) : null;

            const serviceCtx = document.getElementById('serviceChart');
            const serviceChart = serviceCtx ? new Chart(serviceCtx, {
                type: 'bar',
                data: {
                    labels: serviceLabels,
                    datasets: [{
                        label: 'Catalog Price (₱)',
                        data: servicePrices,
                        backgroundColor: 'rgba(198, 142, 0, 0.78)',
                        borderColor: '#C68E00',
                        borderWidth: 1.5,
                        borderRadius: 8,
                        maxBarThickness: 44
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                color: colors.textColor,
                                font: { family: '"Metropolis", sans-serif', size: 12, weight: '600' }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: {
                                color: colors.mutedColor,
                                font: { family: '"Metropolis", sans-serif', size: 11 }
                            },
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: colors.mutedColor,
                                font: { family: '"Metropolis", sans-serif', size: 11 },
                                callback: (val) => '₱' + val
                            },
                            grid: { color: colors.gridColor }
                        }
                    }
                }
            }) : null;

            // Keep Chart.js labels and gridlines synced when user toggles light/dark theme
            const themeBtn = document.getElementById('switch-theme');
            if (themeBtn) {
                themeBtn.addEventListener('click', () => {
                    requestAnimationFrame(() => {
                        const updated = getThemeColors();
                        if (statusChart) {
                            statusChart.data.datasets[0].borderColor = updated.sliceBorderColor;
                            statusChart.options.plugins.legend.labels.color = updated.textColor;
                            statusChart.update();
                        }
                        if (serviceChart) {
                            serviceChart.options.plugins.legend.labels.color = updated.textColor;
                            serviceChart.options.scales.x.ticks.color = updated.mutedColor;
                            serviceChart.options.scales.y.ticks.color = updated.mutedColor;
                            serviceChart.options.scales.y.grid.color = updated.gridColor;
                            serviceChart.update();
                        }
                    });
                });
            }
        });
    </script>
{% endblock %}
