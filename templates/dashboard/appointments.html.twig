{% extends 'dashboard/layout.html.twig' %}

{% block title %}Appointments · S Beauty Salon{% endblock %}

{% block styles %}
    td { vertical-align: middle; }
    select, input, textarea { font: inherit; }
    button { background: #C68E00; color: #fff; border: 0; border-radius: 8px; padding: 6px 12px; font-weight: 700; cursor: pointer; font-family: var(--font-admin); transition: background 0.15s; }
    button:hover { background: #a87700; }

    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }
    .btn-create-appointment {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #C68E00;
        color: #fff;
        border: 0;
        border-radius: 10px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        font-family: var(--font-admin);
        transition: background 0.15s, transform 0.1s;
    }
    .btn-create-appointment:hover {
        background: #a87700;
        transform: translateY(-1px);
    }

    /* Action Buttons Row */
    .action-group {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }
    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        font-family: var(--font-admin);
        cursor: pointer;
        transition: all 0.15s;
    }
    .btn-view {
        background: rgba(37, 99, 235, 0.1);
        color: #2563eb;
        border: 1px solid rgba(37, 99, 235, 0.3);
    }
    .btn-view:hover {
        background: #2563eb;
        color: #ffffff;
    }
    .btn-edit {
        background: rgba(198, 142, 0, 0.12);
        color: #C68E00;
        border: 1px solid rgba(198, 142, 0, 0.35);
    }
    .btn-edit:hover {
        background: #C68E00;
        color: #ffffff;
    }
    .btn-delete {
        background: rgba(220, 38, 38, 0.08);
        color: #dc2626;
        border: 1px solid rgba(220, 38, 38, 0.28);
    }
    .btn-delete:hover {
        background: #dc2626;
        color: #ffffff;
    }

    /* Status Form in Table */
    .status-form {
        display: inline-flex;
        gap: 5px;
        align-items: center;
        white-space: nowrap;
    }
    .status-select {
        padding: 5px 8px;
        border: 1px solid var(--input-border, #d1d5db);
        border-radius: 8px;
        background: var(--input-bg, #fff);
        color: var(--input-text, #1f2937);
        font-size: 12px;
    }

    /* Modals */
    .salon-modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 60;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
        padding: 20px;
        overflow-y: auto;
    }
    .salon-modal-backdrop.is-open {
        display: flex;
    }
    .salon-modal {
        width: 100%;
        max-width: 600px;
        background: var(--card-bg, #ffffff);
        color: var(--main-text, #1f2937);
        border: 1px solid var(--card-border, rgba(198, 142, 0, 0.3));
        border-radius: 20px;
        padding: 26px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        max-height: 90vh;
        overflow-y: auto;
    }
    .salon-modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--table-border, #e5e7eb);
    }
    .salon-modal-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: 21px;
    }
    .salon-modal-title i {
        color: #C68E00;
        font-size: 24px;
    }
    .salon-modal-close {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: transparent;
        border: 1px solid var(--input-border, #d1d5db);
        color: var(--main-muted, #4b5563);
        padding: 0;
        font-size: 18px;
    }
    .salon-modal-close:hover {
        background: rgba(198, 142, 0, 0.15);
        color: #C68E00;
        border-color: #C68E00;
    }
    .salon-modal-sub {
        margin: -6px 0 16px;
        font-size: 13px;
        color: var(--main-sub, #6b7280);
        font-family: var(--font-admin);
    }
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }
    .form-grid .full-span {
        grid-column: 1 / -1;
    }
    .field {
        width: 100%;
        margin-top: 5px;
        padding: 9px 12px;
        border: 1px solid var(--input-border, #d1d5db);
        border-radius: 10px;
        background: var(--input-bg, #fff);
        color: var(--input-text, #1f2937);
        font-size: 14px;
        font-family: var(--font-admin);
    }
    .field:focus {
        outline: none;
        border-color: #C68E00;
        box-shadow: 0 0 0 2px rgba(198, 142, 0, 0.15);
    }
    label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: var(--main-muted, #4b5563);
        font-family: var(--font-admin);
    }
    .salon-modal-foot {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid var(--table-border, #e5e7eb);
    }
    .btn-cancel {
        background: transparent;
        color: var(--main-muted, #4b5563);
        border: 1px solid var(--input-border, #d1d5db);
        padding: 8px 16px;
    }
    .btn-cancel:hover {
        background: rgba(0, 0, 0, 0.05);
        color: var(--main-text, #1f2937);
    }
    .btn-save {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 18px;
    }

    /* Client Mode Tabs */
    .client-toggle {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
        background: rgba(0, 0, 0, 0.04);
        padding: 4px;
        border-radius: 10px;
    }
    .client-tab-btn {
        flex: 1;
        padding: 6px 12px;
        background: transparent;
        color: var(--main-muted, #4b5563);
        border-radius: 8px;
        font-size: 12px;
        border: 0;
        text-align: center;
        font-weight: 600;
    }
    .client-tab-btn.is-active {
        background: #C68E00;
        color: #ffffff;
    }

    .badge-status {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }
    .status-pending { background: rgba(245, 158, 11, 0.15); color: #b45309; }
    .status-confirmed { background: rgba(16, 185, 129, 0.15); color: #047857; }
    .status-completed { background: rgba(59, 130, 246, 0.15); color: #1d4ed8; }
    .status-cancelled { background: rgba(239, 68, 68, 0.15); color: #b91c1c; }

    @media (max-width: 640px) {
        .form-grid { grid-template-columns: 1fr; }
        .action-group { flex-wrap: wrap; }
    }
{% endblock %}

{% block content %}
    {% set statuses = {1: 'Pending', 2: 'Confirmed', 3: 'Completed', 4: 'Cancelled'} %}
    {% set staffMap = {} %}
    {% for member in staff|default([]) %}
        {% set staffMap = staffMap|merge({(member.id): (member.first_name ~ ' ' ~ member.last_name)|trim}) %}
    {% endfor %}

    <div class="page-head">
        <div>
            <h1>Appointments</h1>
            <p class="lede">Manage scheduled bookings, add new appointments, update details, or change statuses.</p>
        </div>
        <button type="button" class="btn-create-appointment" id="openAddAppointmentModal">
            <i class="ti ti-calendar-plus"></i>
            <span>Schedule New Appointment</span>
        </button>
    </div>

    <section class="card">
        {% include 'partials/datatable_filter.html.twig' with {
            filterForm: filterForm,
            resetPath: path('admin_appointments')
        } %}
        <div style="overflow-x:auto;">
            <table
                data-datatable
                data-page-length="10"
                data-search-placeholder="Search appointments..."
                data-empty-text="No appointments on the book."
            >
                <thead>
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Client</th>
                        <th>Service</th>
                        <th>Artist</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th data-orderable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for appointment in appointments %}
                        {% set statusLabel = statuses[appointment.status_id] ?? 'Pending' %}
                        {% set artistName = staffMap[appointment.staff_id] ?? ('Staff #' ~ appointment.staff_id) %}
                        {% set appPhone = appointment.phone is defined and appointment.phone != '' ? appointment.phone : 'N/A' %}
                        {% set appNotes = appointment.customer_notes is defined ? appointment.customer_notes : '' %}
                        {% set appDuration = appointment.duration_minutes is defined ? appointment.duration_minutes : 60 %}
                        {% set appEndTime = appointment.end_time is defined and appointment.end_time != '' ? appointment.end_time : '' %}
                        <tr>
                            <td style="white-space: nowrap;">{{ appointment.appointment_date|date('M j, Y') }} {{ appointment.start_time|date('g:i A') }}</td>
                            <td>
                                <div><strong>{{ appointment.customer_name }}</strong></div>
                                <div style="font-size:12px;color:var(--main-sub,#6b7280);">{{ appointment.email }}</div>
                            </td>
                            <td data-filter-value="{{ appointment.service_name }}">{{ appointment.service_name }}</td>
                            <td data-filter-value="{{ artistName }}">{{ artistName }}</td>
                            <td style="white-space: nowrap;">₱{{ appointment.price }}</td>
                            <td data-filter-value="{{ statusLabel }}" data-search="{{ statusLabel }}">
                                <span class="badge-status status-{{ statusLabel|lower }}">{{ statusLabel }}</span>
                            </td>
                            <td>
                                <div class="action-group">
                                    {# Read / View Link to centralized show page #}
                                    <a
                                        href="{{ path('admin_appointment_show', {'id': appointment.id}) }}"
                                        class="btn-action btn-view"
                                        title="View appointment #{{ appointment.id }}"
                                    >
                                        <i class="ti ti-eye"></i>
                                        <span>View</span>
                                    </a>

                                    {# Fast Status Change - Auto-submits on change (Industry standard, no separate button) #}
                                    <form class="status-form" method="post" action="{{ path('admin_appointment_status') }}" style="margin:0;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_action') }}">
                                        <input type="hidden" name="appointment_id" value="{{ appointment.id }}">
                                        <select class="status-select" name="status_id" aria-label="Status for {{ appointment.customer_name }}" onchange="this.form.submit()">
                                            {% for id, label in statuses %}
                                                <option value="{{ id }}" {% if appointment.status_id == id %}selected{% endif %}>{{ label }}</option>
                                            {% endfor %}
                                        </select>
                                    </form>

                                    {# Edit Button #}
                                    <button
                                        type="button"
                                        class="btn-action btn-edit"
                                        data-edit-appointment
                                        data-id="{{ appointment.id }}"
                                        data-customer-id="{{ appointment.customer_id|default(0) }}"
                                        data-client="{{ appointment.customer_name|e('html_attr') }}"
                                        data-staff-id="{{ appointment.staff_id }}"
                                        data-service-id="{{ appointment.service_id }}"
                                        data-date="{{ appointment.appointment_date|date('Y-m-d') }}"
                                        data-time="{{ appointment.start_time|date('H:i') }}"
                                        data-price="{{ appointment.price }}"
                                        data-status-id="{{ appointment.status_id }}"
                                        data-notes="{{ appNotes|e('html_attr') }}"
                                    >
                                        <i class="ti ti-edit"></i>
                                        <span>Edit</span>
                                    </button>

                                    {# Delete Button #}
                                    <form method="post" action="{{ path('admin_appointment_delete') }}" onsubmit="return confirm('Permanently delete appointment #{{ appointment.id }} for {{ appointment.customer_name }}?');" style="margin:0;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_action') }}">
                                        <input type="hidden" name="appointment_id" value="{{ appointment.id }}">
                                        <button class="btn-action btn-delete" type="submit">
                                            <i class="ti ti-trash"></i>
                                            <span>Delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {# 1. CREATE APPOINTMENT MODAL #}
    <div class="salon-modal-backdrop" id="addAppointmentModal" role="dialog" aria-modal="true" aria-labelledby="addModalTitle">
        <div class="salon-modal">
            <div class="salon-modal-head">
                <h2 class="salon-modal-title" id="addModalTitle">
                    <i class="ti ti-calendar-plus"></i>
                    <span>Schedule New Appointment</span>
                </h2>
                <button type="button" class="salon-modal-close" id="closeAddModal" aria-label="Close modal">
                    <i class="ti ti-x"></i>
                </button>
            </div>
            <p class="salon-modal-sub">Book a client session, assign a stylist, and set pricing details.</p>

            <form method="post" action="{{ path('admin_appointment_create') }}" id="createAppointmentForm">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_action') }}">

                <div class="client-toggle" role="tablist">
                    <button type="button" class="client-tab-btn is-active" id="tabExistingClient">Existing Client</button>
                    <button type="button" class="client-tab-btn" id="tabNewClient">+ New Client</button>
                </div>

                {# Section: Existing Customer #}
                <div id="sectionExistingClient" class="form-grid" style="margin-bottom: 14px;">
                    <label class="full-span">Select Client
                        <select class="field" name="customer_id" id="addCustomerId">
                            <option value="">— Choose a registered customer —</option>
                            {% for cust in customers|default([]) %}
                                <option value="{{ cust.id }}">{{ cust.first_name }} {{ cust.last_name }} ({{ cust.email }})</option>
                            {% endfor %}
                        </select>
                    </label>
                </div>

                {# Section: New Customer #}
                <div id="sectionNewClient" class="form-grid" style="display: none; margin-bottom: 14px;">
                    <label class="full-span">Full Name
                        <input class="field" type="text" name="new_customer_name" id="addNewCustName" placeholder="Client First and Last Name">
                    </label>
                    <label>Email Address
                        <input class="field" type="email" name="new_customer_email" id="addNewCustEmail" placeholder="client@example.com">
                    </label>
                    <label>Phone Number
                        <input class="field" type="tel" name="new_customer_phone" id="addNewCustPhone" placeholder="+63 9xx xxx xxxx">
                    </label>
                </div>

                <div class="form-grid">
                    <label class="full-span">Service
                        <select class="field" name="service_id" id="addServiceId" required>
                            <option value="">— Select Service —</option>
                            {% for service in services|default([]) %}
                                <option
                                    value="{{ service.id }}"
                                    data-price="{{ service.price|default(0) }}"
                                    data-duration="{{ service.duration_minutes|default(60) }}"
                                >
                                    {{ service.name }} (₱{{ service.price|default(0)|number_format(2) }})
                                </option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>Artist / Stylist
                        <select class="field" name="staff_id" id="addStaffId" required>
                            {% for member in staff|default([]) %}
                                <option value="{{ member.id }}">{{ member.first_name }} {{ member.last_name }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>Price (₱)
                        <input class="field" type="number" name="price" id="addPrice" min="0" step="0.01" required placeholder="0.00">
                    </label>

                    <label>Date
                        <input class="field" type="date" name="appointment_date" id="addDate" value="{{ "now"|date("Y-m-d") }}" required>
                    </label>

                    <label>Start Time
                        <input class="field" type="time" name="start_time" id="addTime" value="10:00" required>
                    </label>

                    <label class="full-span">Status
                        <select class="field" name="status_id" id="addStatusId" required>
                            <option value="1">Pending</option>
                            <option value="2" selected>Confirmed</option>
                            <option value="3">Completed</option>
                            <option value="4">Cancelled</option>
                        </select>
                    </label>

                    <label class="full-span">Customer / Styling Notes (Optional)
                        <textarea class="field" name="customer_notes" id="addNotes" rows="2" placeholder="Special requirements, skin sensitivities, occasion details..."></textarea>
                    </label>
                </div>

                <div class="salon-modal-foot">
                    <button type="button" class="btn-cancel" id="cancelAddModal">Cancel</button>
                    <button type="submit" class="btn-save">
                        <i class="ti ti-calendar-plus"></i>
                        <span>Schedule Appointment</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# 2. EDIT APPOINTMENT MODAL #}
    <div class="salon-modal-backdrop" id="editAppointmentModal" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
        <div class="salon-modal">
            <div class="salon-modal-head">
                <h2 class="salon-modal-title" id="editModalTitle">
                    <i class="ti ti-edit"></i>
                    <span>Edit Appointment</span>
                </h2>
                <button type="button" class="salon-modal-close" id="closeEditModal" aria-label="Close modal">
                    <i class="ti ti-x"></i>
                </button>
            </div>
            <p class="salon-modal-sub" id="editModalClientSub">Update booking details below.</p>

            <form method="post" action="{{ path('admin_appointment_update') }}" id="editAppointmentForm">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_action') }}">
                <input type="hidden" name="appointment_id" id="modalAppointmentId" value="">

                <div class="form-grid">
                    <label class="full-span">Client
                        <select class="field" name="customer_id" id="modalCustomerId">
                            {% for cust in customers|default([]) %}
                                <option value="{{ cust.id }}">{{ cust.first_name }} {{ cust.last_name }} ({{ cust.email }})</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label class="full-span">Service
                        <select class="field" name="service_id" id="modalServiceId" required>
                            {% for service in services|default([]) %}
                                <option
                                    value="{{ service.id }}"
                                    data-price="{{ service.price|default(0) }}"
                                >
                                    {{ service.name }} (₱{{ service.price|default(0)|number_format(2) }})
                                </option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>Artist
                        <select class="field" name="staff_id" id="modalStaffId" required>
                            {% for member in staff|default([]) %}
                                <option value="{{ member.id }}">{{ member.first_name }} {{ member.last_name }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>Price (₱)
                        <input class="field" type="number" name="price" id="modalPrice" min="0" step="0.01" required>
                    </label>

                    <label>Date
                        <input class="field" type="date" name="appointment_date" id="modalDate" required>
                    </label>

                    <label>Time
                        <input class="field" type="time" name="start_time" id="modalTime" required>
                    </label>

                    <label class="full-span">Status
                        <select class="field" name="status_id" id="modalStatusId" required>
                            <option value="1">Pending</option>
                            <option value="2">Confirmed</option>
                            <option value="3">Completed</option>
                            <option value="4">Cancelled</option>
                        </select>
                    </label>

                    <label class="full-span">Notes
                        <textarea class="field" name="customer_notes" id="modalNotes" rows="2" placeholder="Special requirements, styling notes..."></textarea>
                    </label>
                </div>

                <div class="salon-modal-foot">
                    <button type="button" class="btn-cancel" id="cancelEditModal">Cancel</button>
                    <button type="submit" class="btn-save">
                        <i class="ti ti-device-floppy"></i>
                        <span>Save Details</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Modals
        const addModal = document.getElementById('addAppointmentModal');
        const openAddBtn = document.getElementById('openAddAppointmentModal');
        const closeAddBtn = document.getElementById('closeAddModal');
        const cancelAddBtn = document.getElementById('cancelAddModal');

        const editModal = document.getElementById('editAppointmentModal');
        const closeEditBtn = document.getElementById('closeEditModal');
        const cancelEditBtn = document.getElementById('cancelEditModal');

        // Add Modal Elements
        const tabExisting = document.getElementById('tabExistingClient');
        const tabNew = document.getElementById('tabNewClient');
        const secExisting = document.getElementById('sectionExistingClient');
        const secNew = document.getElementById('sectionNewClient');
        const addServiceSelect = document.getElementById('addServiceId');
        const addPriceInput = document.getElementById('addPrice');

        // Edit Modal Elements
        const editIdInput = document.getElementById('modalAppointmentId');
        const editCustomerSelect = document.getElementById('modalCustomerId');
        const editServiceSelect = document.getElementById('modalServiceId');
        const editStaffSelect = document.getElementById('modalStaffId');
        const editPriceInput = document.getElementById('modalPrice');
        const editDateInput = document.getElementById('modalDate');
        const editTimeInput = document.getElementById('modalTime');
        const editStatusSelect = document.getElementById('modalStatusId');
        const editNotesInput = document.getElementById('modalNotes');
        const editClientSub = document.getElementById('editModalClientSub');

        function closeAllModals() {
            if (addModal) addModal.classList.remove('is-open');
            if (editModal) editModal.classList.remove('is-open');
        }

        // Add Modal Open/Close
        if (openAddBtn) {
            openAddBtn.addEventListener('click', () => {
                closeAllModals();
                if (addModal) addModal.classList.add('is-open');
            });
        }
        if (closeAddBtn) closeAddBtn.addEventListener('click', closeAllModals);
        if (cancelAddBtn) cancelAddBtn.addEventListener('click', closeAllModals);

        // Edit Modal Close
        if (closeEditBtn) closeEditBtn.addEventListener('click', closeAllModals);
        if (cancelEditBtn) cancelEditBtn.addEventListener('click', closeAllModals);

        // Existing / New Client Tabs
        if (tabExisting && tabNew && secExisting && secNew) {
            tabExisting.addEventListener('click', () => {
                tabExisting.classList.add('is-active');
                tabNew.classList.remove('is-active');
                secExisting.style.display = 'grid';
                secNew.style.display = 'none';
                const custSelect = document.getElementById('addCustomerId');
                if (custSelect) custSelect.required = true;
            });
            tabNew.addEventListener('click', () => {
                tabNew.classList.add('is-active');
                tabExisting.classList.remove('is-active');
                secExisting.style.display = 'none';
                secNew.style.display = 'grid';
                const custSelect = document.getElementById('addCustomerId');
                if (custSelect) {
                    custSelect.required = false;
                    custSelect.value = '';
                }
            });
        }

        // Auto-fill price in Add modal when Service changes
        if (addServiceSelect && addPriceInput) {
            addServiceSelect.addEventListener('change', () => {
                const opt = addServiceSelect.options[addServiceSelect.selectedIndex];
                if (opt && opt.dataset.price) {
                    addPriceInput.value = parseFloat(opt.dataset.price).toFixed(2);
                }
            });
        }

        // Auto-fill price in Edit modal when Service changes
        if (editServiceSelect && editPriceInput) {
            editServiceSelect.addEventListener('change', () => {
                const opt = editServiceSelect.options[editServiceSelect.selectedIndex];
                if (opt && opt.dataset.price) {
                    editPriceInput.value = parseFloat(opt.dataset.price).toFixed(2);
                }
            });
        }

        function openEditModalWithData(data) {
            closeAllModals();
            if (!editModal) return;

            if (editIdInput) editIdInput.value = data.id || '';

            if (editCustomerSelect) {
                if (data.customerId && data.customerId !== '0') {
                    editCustomerSelect.value = String(data.customerId);
                }
                // Fallback: match by client name if selection didn't take
                if (editCustomerSelect.selectedIndex < 0 && data.client) {
                    for (let i = 0; i < editCustomerSelect.options.length; i++) {
                        if (editCustomerSelect.options[i].text.toLowerCase().includes(data.client.toLowerCase())) {
                            editCustomerSelect.selectedIndex = i;
                            break;
                        }
                    }
                }
            }

            if (editServiceSelect && data.serviceId) {
                editServiceSelect.value = String(data.serviceId);
            }
            if (editStaffSelect && data.staffId) {
                editStaffSelect.value = String(data.staffId);
            }

            // Clean price input to ensure pure numeric value
            if (editPriceInput) {
                const rawPrice = String(data.price || '0').replace(/[^0-9.]/g, '');
                editPriceInput.value = parseFloat(rawPrice || 0).toFixed(2);
            }

            if (editDateInput) {
                editDateInput.value = data.date || '';
            }

            // Ensure 24-hr time format HH:MM for input[type="time"]
            if (editTimeInput) {
                let formattedTime = String(data.time || '').trim();
                if (formattedTime.length === 4 && formattedTime.indexOf(':') === 1) {
                    formattedTime = '0' + formattedTime;
                } else if (formattedTime.length >= 5) {
                    formattedTime = formattedTime.substring(0, 5);
                }
                editTimeInput.value = formattedTime;
            }

            if (editStatusSelect && data.statusId) {
                editStatusSelect.value = String(data.statusId);
            }
            if (editNotesInput) {
                editNotesInput.value = data.notes || '';
            }

            if (editClientSub) {
                editClientSub.textContent = data.client
                    ? 'Updating appointment #' + data.id + ' for ' + data.client
                    : 'Update booking details below.';
            }

            editModal.classList.add('is-open');
        }

        // Edit button click in table
        document.addEventListener('click', (e) => {
            const editBtn = e.target.closest('[data-edit-appointment]');
            if (editBtn) {
                openEditModalWithData({
                    id: editBtn.dataset.id,
                    customerId: editBtn.dataset.customerId,
                    client: editBtn.dataset.client,
                    staffId: editBtn.dataset.staffId,
                    serviceId: editBtn.dataset.serviceId,
                    date: editBtn.dataset.date,
                    time: editBtn.dataset.time,
                    price: editBtn.dataset.price,
                    statusId: editBtn.dataset.statusId,
                    notes: editBtn.dataset.notes,
                });
            }
        });

        // Close on backdrop click
        [addModal, editModal].forEach((m) => {
            if (m) {
                m.addEventListener('click', (e) => {
                    if (e.target === m) closeAllModals();
                });
            }
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeAllModals();
        });
    });
</script>
{% endblock %}
