{% extends 'dashboard/layout.html.twig' %}

{% block title %}Services · S Beauty Salon{% endblock %}

{% block styles %}
    .add-grid { display: grid; grid-template-columns: 1.4fr 1fr .7fr .8fr 1fr auto; gap: 10px; align-items: end; }
    .field, select { width: 100%; padding: 8px 10px; border: 1px solid var(--input-border, #d1d5db); border-radius: 10px; font: inherit; }
    button { background: #C68E00; color: #fff; border: 0; border-radius: 8px; padding: 8px 14px; font-weight: 700; cursor: pointer; font-family: "Segoe UI", sans-serif; transition: all 0.15s; }
    button:hover { background: #a87700; }
    .btn-delete {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 11px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        background: rgba(220, 38, 38, 0.08);
        color: #dc2626;
        border: 1px solid rgba(220, 38, 38, 0.28);
    }
    .btn-delete:hover {
        background: #dc2626;
        color: #ffffff;
    }
    label { display: block; font-size: 12px; font-weight: 700; color: var(--main-muted, #4b5563); font-family: "Segoe UI", sans-serif; }
    @media (max-width: 900px) { .add-grid { grid-template-columns: 1fr; } }
{% endblock %}

{% block content %}
    <h1>Services</h1>
    <p class="lede">Add a service, then edit or remove it from the catalog.</p>

    <section class="card">
        <h2>Add a service</h2>
        <form method="post" action="{{ path('admin_service_create') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_action') }}">
            <div class="add-grid">
                <label>Service name
                    <input class="field" name="service_name" required placeholder="Service name">
                </label>
                <label>Category
                    <select class="field" name="category_id">
                        {% for category in categories %}
                            <option value="{{ category.id }}">{{ category.name }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>Duration
                    <input class="field" type="number" name="duration" min="15" value="60" required>
                </label>
                <label>Price
                    <input class="field" type="number" name="price" min="0" step="0.01" required placeholder="Price">
                </label>
                <label>Description
                    <input class="field" name="description" placeholder="Description (optional)">
                </label>
                <button type="submit">Add</button>
            </div>
        </form>
    </section>

    <section class="card">
        <div style="overflow-x:auto;">
            <table
                data-datatable
                data-page-length="10"
                data-search-placeholder="Search services..."
                data-empty-text="No services in the catalog."
                data-filter-columns='[{"index": 1, "label": "Category"}]'
            >
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Duration</th>
                        <th>Price</th>
                        <th data-orderable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for service in services %}
                        {% set minutes = service.duration_minutes is defined ? service.duration_minutes : (service.minutes is defined ? service.minutes : (service.duration is defined ? service.duration : '')) %}
                        {% set serviceName = service.name is defined ? service.name : (service.service_name is defined ? service.service_name : '') %}
                        {% set categoryLabel = service.category_name is defined ? service.category_name : (service.category is defined and service.category.name is defined ? service.category.name : (service.category is defined ? service.category : '')) %}
                        <tr>
                            <td><strong>{{ serviceName }}</strong></td>
                            <td data-filter-value="{{ categoryLabel }}">{{ categoryLabel }}</td>
                            <td>{% if minutes != '' %}{{ minutes }} mins{% endif %}</td>
                            <td>₱{{ service.price is defined ? service.price : '' }}</td>
                            <td>
                                <form method="post" action="{{ path('admin_service_delete') }}" onsubmit="return confirm('Remove this service?');" style="margin:0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_action') }}">
                                    <input type="hidden" name="service_id" value="{{ service.id }}">
                                    <button class="btn-delete" type="submit">
                                        <i class="ti ti-trash"></i>
                                        <span>Delete</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
