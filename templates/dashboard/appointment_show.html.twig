{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Universal modal opener and closer helper
        function openModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.add('is-open');
        }

        function closeModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.remove('is-open');
        }

        // Close triggers by data-close
        document.querySelectorAll('[data-close]').forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-close');
                if (targetId) closeModal(targetId);
            });
        });

        // Click outside backdrop to close
        document.querySelectorAll('.salon-modal-backdrop').forEach(backdrop => {
            backdrop.addEventListener('click', (e) => {
                if (e.target === backdrop) {
                    backdrop.classList.remove('is-open');
                }
            });
        });

        // Esc key closes any open modal
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                document.querySelectorAll('.salon-modal-backdrop.is-open').forEach(m => m.classList.remove('is-open'));
            }
        });

        // Button binders
        const openers = [
            { btn: 'openCreateModal', modal: 'scheduleAppointmentModal' },
            { btn: 'openEditModal', modal: 'editAppointmentModal' },
            { btn: 'openEditClientModal', modal: 'editClientModal' },
            { btn: 'openEditServiceModal', modal: 'editServiceModal' },
            { btn: 'openEditNotesModal', modal: 'editNotesModal' },
            { btn: 'openEditScheduleModal', modal: 'editScheduleModal' },
            { btn: 'openEditFeeModal', modal: 'editFeeModal' },
        ];

        openers.forEach(({ btn, modal }) => {
            const el = document.getElementById(btn);
            if (el) {
                el.addEventListener('click', () => openModal(modal));
            }
        });

        // Dynamic price update for Full Edit modal
        const serviceSelect = document.getElementById('editServiceId');
        const priceInput = document.getElementById('editPrice');
        if (serviceSelect && priceInput) {
            serviceSelect.addEventListener('change', () => {
                const opt = serviceSelect.options[serviceSelect.selectedIndex];
                if (opt && opt.dataset.price) {
                    priceInput.value = parseFloat(opt.dataset.price).toFixed(2);
                }
            });
        }

        // Dynamic price update for Quick Service modal
        const quickServiceSelect = document.getElementById('quickServiceSelect');
        const quickServicePrice = document.getElementById('quickServicePrice');
        if (quickServiceSelect && quickServicePrice) {
            quickServiceSelect.addEventListener('change', () => {
                const opt = quickServiceSelect.options[quickServiceSelect.selectedIndex];
                if (opt && opt.dataset.price) {
                    quickServicePrice.value = parseFloat(opt.dataset.price).toFixed(2);
                }
            });
        }

        // Dynamic price update for Schedule New Appointment modal
        const newServiceSelect = document.getElementById('newAppointmentServiceSelect');
        const newPriceInput = document.getElementById('newAppointmentPrice');
        if (newServiceSelect && newPriceInput) {
            newServiceSelect.addEventListener('change', () => {
                const opt = newServiceSelect.options[newServiceSelect.selectedIndex];
                if (opt && opt.dataset.price) {
                    newPriceInput.value = parseFloat(opt.dataset.price).toFixed(2);
                }
            });
        }

        // Toggle new client fields in Schedule New Appointment modal
        const newCustSelect = document.getElementById('newAppointmentCustomerSelect');
        const newClientFields = document.getElementById('newClientFieldsGroup');
        if (newCustSelect && newClientFields) {
            newCustSelect.addEventListener('change', () => {
                newClientFields.style.display = (newCustSelect.value === '0') ? 'grid' : 'none';
            });
        }
    });
</script>
{% endblock %}
