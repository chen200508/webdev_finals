{% set labels = {1: 'Pending', 2: 'Confirmed', 3: 'Completed', 4: 'Cancelled'} %}
{% set colors = {1: 'bg-amber-100 text-amber-800', 2: 'bg-blue-100 text-blue-800', 3: 'bg-green-100 text-green-800', 4: 'bg-red-100 text-red-800'} %}
<span class="px-2.5 py-1 rounded-full text-xs font-bold {{ colors[status] ?? 'bg-gray-100 text-gray-700' }}">
    {{ labels[status] ?? 'Unknown' }}
</span>