{% extends 'staff/layout.html.twig' %}

{% block title %}Services · S Beauty Salon{% endblock %}

{% block styles %}
    td { vertical-align: middle; }
    select, input { font: inherit; }
    button { font-family: var(--font-admin); }

    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .btn-create-service {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #C68E00;
        color: #fff;
        border: 0;
        border-radius: 10px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        font-family: var(--font-admin);
        transition: background 0.15s;
    }
    .btn-create-service:hover {
        background: #a87700;
    }

    .field, select {
        width: 100%;
        margin-top: 6px;
        padding: 9px 12px;
        border: 1px solid var(--input-border, #d1d5db);
        border-radius: 10px;
        background: var(--input-bg, #fff);
        color: var(--input-text, #1f2937);
        font-size: 14px;
        font-family: var(--font-admin);
        box-sizing: border-box;
    }
    .field:focus, select:focus {
        outline: none;
        border-color: #C68E00;
        box-shadow: 0 0 0 2px rgba(198, 142, 0, 0.15);
    }

    .salon-modal label, .field-group label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: var(--main-muted, #4b5563);
        font-family: var(--font-admin);
    }

    .badge-category {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        font-family: var(--font-admin);
        background: rgba(198, 142, 0, 0.12);
        color: #C68E00;
        border: 1px solid rgba(198, 142, 0, 0.28);
    }

    .btn-view {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        font-family: var(--font-admin);
        cursor: pointer;
        transition: all 0.15s;
        background: rgba(37, 99, 235, 0.1);
        color: #2563eb;
        border: 1px solid rgba(37, 99, 235, 0.3);
        text-decoration: none;
    }
    .btn-view:hover {
        background: #2563eb;
        color: #ffffff;
    }

    /* Modals */
    .salon-modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 60;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    .salon-modal-backdrop.is-open {
        display: flex;
    }
    .salon-modal {
        width: 100%;
        max-width: 560px;
        background: var(--card-bg, #ffffff);
        color: var(--main-text, #1f2937);
        border: 1px solid var(--card-border, rgba(198, 142, 0, 0.3));
        border-radius: 20px;
        padding: 26px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    }
    .salon-modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--table-border, #e5e7eb);
    }
    .salon-modal-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: 20px;
    }
    .salon-modal-title i {
        color: #C68E00;
        font-size: 22px;
    }
    .salon-modal-close {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: transparent;
        border: 1px solid var(--input-border, #d1d5db);
        color: var(--main-muted, #4b5563);
        padding: 0;
        font-size: 18px;
        cursor: pointer;
    }
    .salon-modal-close:hover {
        background: rgba(198, 142, 0, 0.15);
        color: #C68E00;
        border-color: #C68E00;
    }
    .modal-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }
    .modal-grid .full-span {
        grid-column: 1 / -1;
    }
    .view-detail-table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-admin);
        font-size: 14px;
        margin-bottom: 8px;
    }
    .view-detail-table th {
        width: 36%;
        padding: 10px 12px;
        color: var(--main-muted, #4b5563);
        font-weight: 600;
        font-size: 13px;
        text-align: left;
        border-bottom: 1px solid var(--table-border, #e5e7eb);
        background: rgba(0, 0, 0, 0.015);
    }
    .view-detail-table td {
        padding: 10px 12px;
        color: var(--main-text, #1f2937);
        font-size: 14px;
        text-align: right;
        border-bottom: 1px solid var(--table-border, #e5e7eb);
    }
    .view-detail-table tr:last-child th,
    .view-detail-table tr:last-child td {
        border-bottom: none;
    }
    .salon-modal-foot {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 22px;
        padding-top: 16px;
        border-top: 1px solid var(--table-border, #e5e7eb);
    }
    .btn-close-modal, .btn-cancel {
        background: transparent;
        color: var(--main-muted, #4b5563);
        border: 1px solid var(--input-border, #d1d5db);
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
    }
    .btn-submit-service {
        background: #C68E00;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: 8px 20px;
        font-weight: 700;
        cursor: pointer;
        font-family: var(--font-admin);
    }
    .btn-submit-service:hover {
        background: #a87700;
    }
    .btn-book-service {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #C68E00;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        font-family: var(--font-admin);
    }
    .btn-book-service:hover {
        background: #a87700;
    }

    @media (max-width: 640px) {
        .modal-grid { grid-template-columns: 1fr; }
    }
{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>Services Catalog</h1>
            <p class="lede">Browse all salon treatments, durations, and pricing, or add a new service to the catalog.</p>
        </div>
        <button type="button" class="btn-create-service" id="openAddServiceModal">
            <i class="ti ti-plus"></i>
            <span>Create a new service</span>
        </button>
    </div>

    <section class="card">
        {% include 'partials/datatable_filter.html.twig' with {
            filterForm: filterForm,
            resetPath: path('staff_services')
        } %}
        <div style="overflow-x:auto;">
            <table
                data-datatable
                data-page-length="10"
                data-search-placeholder="Search services..."
                data-empty-text="No services in the catalog."
            >
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Duration</th>
                        <th>Price</th>
                        <th>Description</th>
                        <th data-orderable="false" style="text-align: right;">Details</th>
                    </tr>
                </thead>
                <tbody>
                    {% for service in services %}
                        {% set minutes = service.duration_minutes is defined ? service.duration_minutes : (service.minutes is defined ? service.minutes : (service.duration is defined ? service.duration : '')) %}
                        {% set serviceName = service.name is defined ? service.name : (service.service_name is defined ? service.service_name : '') %}
                        {% set categoryLabel = service.category_name is defined ? service.category_name : (service.category is defined and service.category.name is defined ? service.category.name : (service.category is defined ? service.category : '')) %}
                        {% set serviceDesc = service.description is defined and service.description != '' ? service.description : '—' %}
                        <tr>
                            <td><strong>{{ serviceName }}</strong></td>
                            <td data-filter-value="{{ categoryLabel }}"><span class="badge-category">{{ categoryLabel }}</span></td>
                            <td>{% if minutes != '' %}{{ minutes }} mins{% endif %}</td>
                            <td>₱{{ service.price is defined ? service.price : '' }}</td>
                            <td class="dt-truncate" title="{{ serviceDesc }}">{{ serviceDesc }}</td>
                            <td style="text-align: right;">
                                <button
                                    type="button"
                                    class="btn-view"
                                    data-view-service
                                    data-name="{{ serviceName }}"
                                    data-category="{{ categoryLabel }}"
                                    data-duration="{{ minutes }}"
                                    data-price="{{ service.price is defined ? service.price : 0 }}"
                                    data-description="{{ serviceDesc }}"
                                >
                                    <i class="ti ti-eye"></i>
                                    <span>View</span>
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {# Add a service Modal (Create) #}
    <div class="salon-modal-backdrop" id="addServiceModal" role="dialog" aria-modal="true" aria-labelledby="addServiceModalTitle">
        <div class="salon-modal">
            <div class="salon-modal-head">
                <h2 class="salon-modal-title" id="addServiceModalTitle">
                    <i class="ti ti-scissors"></i>
                    <span>Add a service</span>
                </h2>
                <button type="button" class="salon-modal-close" id="closeAddServiceModal" aria-label="Close modal">
                    <i class="ti ti-x"></i>
                </button>
            </div>

            {{ form_start(serviceForm) }}
                <input type="hidden" name="_token" value="{{ csrf_token('staff_action') }}">
                <div class="modal-grid">
                    <label class="full-span">
                        {{ serviceForm.service_name.vars.label }}
                        {{ form_widget(serviceForm.service_name, {'attr': {'class': 'field'}}) }}
                    </label>

                    <label>
                        {{ serviceForm.category_id.vars.label }}
                        {{ form_widget(serviceForm.category_id, {'attr': {'class': 'field'}}) }}
                    </label>

                    <label>
                        {{ serviceForm.duration.vars.label }}
                        {{ form_widget(serviceForm.duration, {'attr': {'class': 'field'}}) }}
                    </label>

                    <label>
                        {{ serviceForm.price.vars.label }}
                        {{ form_widget(serviceForm.price, {'attr': {'class': 'field'}}) }}
                    </label>

                    <label>
                        {{ serviceForm.description.vars.label }}
                        {{ form_widget(serviceForm.description, {'attr': {'class': 'field'}}) }}
                    </label>
                </div>

                <div class="salon-modal-foot">
                    <button type="button" class="btn-cancel" id="cancelAddServiceModal">Cancel</button>
                    {{ form_widget(serviceForm.add, {'attr': {'class': 'btn-submit-service'}}) }}
                </div>
            {{ form_end(serviceForm) }}
        </div>
    </div>

    {# View Service Modal #}
    <div class="salon-modal-backdrop" id="viewServiceModal" role="dialog" aria-modal="true" aria-labelledby="viewServiceModalTitle">
        <div class="salon-modal">
            <div class="salon-modal-head">
                <h2 class="salon-modal-title" id="viewServiceModalTitle">
                    <i class="ti ti-scissors"></i>
                    <span>Service Details</span>
                </h2>
                <button type="button" class="salon-modal-close" id="closeViewServiceModal" aria-label="Close modal">
                    <i class="ti ti-x"></i>
                </button>
            </div>

            <table class="view-detail-table">
                <tbody>
                    <tr>
                        <th>Treatment Name</th>
                        <td><strong id="viewSvcName">—</strong></td>
                    </tr>
                    <tr>
                        <th>Category</th>
                        <td id="viewSvcCategory">—</td>
                    </tr>
                    <tr>
                        <th>Duration</th>
                        <td id="viewSvcDuration">—</td>
                    </tr>
                    <tr>
                        <th>Price</th>
                        <td><strong id="viewSvcPrice" style="color:#C68E00;">—</strong></td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td id="viewSvcDesc" style="text-align:left;">—</td>
                    </tr>
                </tbody>
            </table>

            <div class="salon-modal-foot">
                <button type="button" class="btn-close-modal" id="cancelViewServiceModal">Close</button>
                <a href="{{ path('staff_appointments') }}" class="btn-book-service">
                    <i class="ti ti-calendar-plus"></i>
                    <span>Go to Appointments</span>
                </a>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const addModal = document.getElementById('addServiceModal');
        const openAddBtn = document.getElementById('openAddServiceModal');
        const closeAddBtn = document.getElementById('closeAddServiceModal');
        const cancelAddBtn = document.getElementById('cancelAddServiceModal');

        const viewModal = document.getElementById('viewServiceModal');
        const closeBtn = document.getElementById('closeViewServiceModal');
        const cancelBtn = document.getElementById('cancelViewServiceModal');

        function closeAllModals() {
            if (addModal) addModal.classList.remove('is-open');
            if (viewModal) viewModal.classList.remove('is-open');
        }

        if (openAddBtn) {
            openAddBtn.addEventListener('click', () => {
                if (addModal) addModal.classList.add('is-open');
            });
        }
        if (closeAddBtn) closeAddBtn.addEventListener('click', closeAllModals);
        if (cancelAddBtn) cancelAddBtn.addEventListener('click', closeAllModals);
        if (closeBtn) closeBtn.addEventListener('click', closeAllModals);
        if (cancelBtn) cancelBtn.addEventListener('click', closeAllModals);

        document.addEventListener('click', (e) => {
            const viewBtn = e.target.closest('[data-view-service]');
            if (viewBtn && viewModal) {
                document.getElementById('viewSvcName').textContent = viewBtn.dataset.name || '—';
                document.getElementById('viewSvcCategory').textContent = viewBtn.dataset.category || '—';
                document.getElementById('viewSvcDuration').textContent = (viewBtn.dataset.duration ? viewBtn.dataset.duration + ' mins' : '—');
                document.getElementById('viewSvcPrice').textContent = '₱' + (viewBtn.dataset.price || '0');
                document.getElementById('viewSvcDesc').textContent = viewBtn.dataset.description || '—';
                viewModal.classList.add('is-open');
            }
        });

        [addModal, viewModal].forEach((m) => {
            if (m) {
                m.addEventListener('click', (e) => {
                    if (e.target === m) closeAllModals();
                });
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeAllModals();
        });
    });
</script>
{% endblock %}
