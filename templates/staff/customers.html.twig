{% extends 'staff/layout.html.twig' %}

{% block title %}Customers · S Beauty Salon{% endblock %}

{% block styles %}
    td { vertical-align: middle; }
    select, input { font: inherit; }
    button { font-family: var(--font-admin); }

    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .btn-create-customer {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #C68E00;
        color: #ffffff;
        border: 0;
        border-radius: 10px;
        padding: 9px 18px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        font-family: var(--font-admin);
        transition: background 0.15s, transform 0.1s;
    }
    .btn-create-customer:hover {
        background: #a87700;
        transform: translateY(-1px);
    }

    .badge-bookings {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        font-family: var(--font-admin);
        background: rgba(198, 142, 0, 0.12);
        color: #C68E00;
        border: 1px solid rgba(198, 142, 0, 0.28);
    }

    .action-group {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        white-space: nowrap;
    }
    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 11px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        font-family: var(--font-admin);
        cursor: pointer;
        transition: all 0.15s;
        border: 0;
        text-decoration: none;
    }
    .btn-view {
        background: rgba(37, 99, 235, 0.1);
        color: #2563eb;
        border: 1px solid rgba(37, 99, 235, 0.3);
    }
    .btn-view:hover {
        background: #2563eb;
        color: #ffffff;
    }
    .btn-edit {
        background: rgba(198, 142, 0, 0.12);
        color: #C68E00;
        border: 1px solid rgba(198, 142, 0, 0.35);
    }
    .btn-edit:hover {
        background: #C68E00;
        color: #ffffff;
    }
    .btn-delete {
        background: rgba(220, 38, 38, 0.08);
        color: #dc2626;
        border: 1px solid rgba(220, 38, 38, 0.28);
    }
    .btn-delete:hover {
        background: #dc2626;
        color: #ffffff;
    }

    /* Modals */
    .salon-modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 60;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    .salon-modal-backdrop.is-open {
        display: flex;
    }
    .salon-modal {
        width: 100%;
        max-width: 520px;
        background: var(--card-bg, #ffffff);
        color: var(--main-text, #1f2937);
        border: 1px solid var(--card-border, rgba(198, 142, 0, 0.3));
        border-radius: 20px;
        padding: 26px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    }
    .salon-modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--table-border, #e5e7eb);
    }
    .salon-modal-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: 21px;
    }
    .salon-modal-title i {
        color: #C68E00;
        font-size: 24px;
    }
    .salon-modal-close {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: transparent;
        border: 1px solid var(--input-border, #d1d5db);
        color: var(--main-muted, #4b5563);
        padding: 0;
        font-size: 18px;
        cursor: pointer;
    }
    .salon-modal-close:hover {
        background: rgba(198, 142, 0, 0.15);
        color: #C68E00;
        border-color: #C68E00;
    }
    .salon-modal-sub {
        font-size: 13px;
        color: var(--main-sub, #6b7280);
        margin-top: -8px;
        margin-bottom: 18px;
    }
    .modal-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }
    .modal-grid .full-span {
        grid-column: 1 / -1;
    }
    .field {
        width: 100%;
        margin-top: 5px;
        padding: 9px 12px;
        border: 1px solid var(--input-border, #d1d5db);
        border-radius: 10px;
        background: var(--input-bg, #fff);
        color: var(--input-text, #1f2937);
        font-size: 14px;
        font-family: var(--font-admin);
        box-sizing: border-box;
    }
    .field:focus {
        outline: none;
        border-color: #C68E00;
        box-shadow: 0 0 0 2px rgba(198, 142, 0, 0.15);
    }
    .salon-modal label, .field-group label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: var(--main-muted, #4b5563);
        font-family: var(--font-admin);
    }
    .salon-modal-foot {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid var(--table-border, #e5e7eb);
    }
    .btn-cancel {
        background: transparent;
        color: var(--main-muted, #4b5563);
        border: 1px solid var(--input-border, #d1d5db);
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
    }
    .btn-save {
        background: #C68E00;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: 8px 18px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-save:hover { background: #a87700; }

    .view-detail-table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-admin);
        font-size: 14px;
        margin-bottom: 8px;
    }
    .view-detail-table th {
        width: 36%;
        padding: 10px 12px;
        color: var(--main-muted, #4b5563);
        font-weight: 600;
        font-size: 13px;
        text-align: left;
        border-bottom: 1px solid var(--table-border, #e5e7eb);
        background: rgba(0, 0, 0, 0.015);
    }
    .view-detail-table td {
        padding: 10px 12px;
        color: var(--main-text, #1f2937);
        font-size: 14px;
        text-align: right;
        border-bottom: 1px solid var(--table-border, #e5e7eb);
    }
    .view-detail-table tr:last-child th,
    .view-detail-table tr:last-child td {
        border-bottom: none;
    }

    /* Tabs / Filter Pills */
    .view-pills {
        display: inline-flex;
        background: rgba(198, 142, 0, 0.12);
        padding: 4px;
        border-radius: 12px;
        gap: 4px;
        margin-bottom: 16px;
    }
    .view-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        color: var(--main-muted);
        text-decoration: none;
        transition: all 0.15s;
    }
    .view-pill.active {
        background: #C68E00;
        color: #ffffff;
    }
{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <p class="eyebrow">Client Directory</p>
            <h1>Customers</h1>
            <p class="lede">Manage your client records and view shared customer profiles at S Beauty Salon.</p>
        </div>
        <button type="button" class="btn-create-customer" id="openAddCustomerModal">
            <i class="ti ti-user-plus"></i>
            <span>Add Customer</span>
        </button>
    </div>

    <!-- View Mode Pills -->
    <div class="view-pills">
        <a href="{{ path('staff_customers', {'view': 'all'}) }}" class="view-pill {{ (viewMode|default('all')) == 'all' ? 'active' : '' }}">
            <i class="ti ti-users"></i> All Salon Clients
        </a>
        <a href="{{ path('staff_customers', {'view': 'mine'}) }}" class="view-pill {{ (viewMode|default('all')) == 'mine' ? 'active' : '' }}">
            <i class="ti ti-user-check"></i> My Clients ({{ myClientsCount|default(0) }})
        </a>
    </div>

    <section class="card">
        {% include 'partials/datatable_filter.html.twig' with {
            filterForm: filterForm,
            resetPath: path('staff_customers', {'view': viewMode|default('all')})
        } %}
        <div style="overflow-x:auto;">
            <table
                data-datatable
                data-page-length="10"
                data-order-col="0"
                data-order-dir="desc"
                data-search-placeholder="Search customers..."
                data-empty-text="No customers yet."
            >
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Artist</th>
                        <th style="width: 110px;">Bookings</th>
                        <th data-orderable="false" style="width: 190px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for customer in customers %}
                        {% set firstName = customer.first_name|default('') %}
                        {% set lastName = customer.last_name|default('') %}
                        {% set customerName = customer.name is defined ? customer.name : (customer.customer_name is defined ? customer.customer_name : (firstName ~ ' ' ~ lastName)|trim) %}
                        {% set totalBookings = customer.total_bookings|default(0) %}
                        {% set isOwner = (customer.staff_id|default(0) == currentStaffId|default(0)) %}
                        <tr>
                            <td data-order="{{ customer.id|default(loop.revindex) }}">{{ loop.index }}</td>
                            <td>{{ customerName }}</td>
                            <td>{{ customer.email|default('—') }}</td>
                            <td>{{ customer.phone|default('—') }}</td>
                            <td>
                                {% if isOwner %}
                                    <span style="color: #C68E00;">You ({{ staffMember.first_name }})</span>
                                {% else %}
                                    <span>{{ customer.staff_name|default('Admin / Shared') }}</span>
                                {% endif %}
                            </td>
                            <td>{{ totalBookings }} {{ totalBookings == 1 ? 'booking' : 'bookings' }}</td>
                            <td style="text-align: right;">
                                <div class="action-group">
                                    <button
                                        type="button"
                                        class="btn-action btn-view btn-view-customer"
                                        data-id="{{ customer.id }}"
                                        data-name="{{ customerName }}"
                                        data-first="{{ firstName }}"
                                        data-last="{{ lastName }}"
                                        data-email="{{ customer.email|default('') }}"
                                        data-phone="{{ customer.phone|default('') }}"
                                        data-bookings="{{ totalBookings }}"
                                        data-owner="{{ isOwner ? '1' : '0' }}"
                                        title="View customer details"
                                    >
                                        <i class="ti ti-eye"></i>
                                        <span>View</span>
                                    </button>

                                    {% if isOwner %}
                                        <button
                                            type="button"
                                            class="btn-action btn-edit btn-edit-customer"
                                            data-id="{{ customer.id }}"
                                            data-first="{{ firstName }}"
                                            data-last="{{ lastName }}"
                                            data-name="{{ customerName }}"
                                            data-email="{{ customer.email|default('') }}"
                                            data-phone="{{ customer.phone|default('') }}"
                                            title="Edit own customer details"
                                        >
                                            <i class="ti ti-edit"></i>
                                            <span>Edit</span>
                                        </button>

                                        <button
                                            type="button"
                                            class="btn-action btn-delete js-delete-customer-btn"
                                            data-id="{{ customer.id }}"
                                            data-name="{{ customerName|e('html_attr') }}"
                                            data-email="{{ customer.email|default('')|e('html_attr') }}"
                                            title="Delete own customer"
                                        >
                                            <i class="ti ti-trash"></i>
                                            <span>Delete</span>
                                        </button>
                                    {% else %}
                                        <span class="muted" style="font-size:11px;display:inline-flex;align-items:center;gap:4px;" title="Only the assigned staff member or admin can edit or delete this record">
                                            <i class="ti ti-lock"></i> Read-only
                                        </span>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {# Modal 1: Add Customer #}
    <div class="salon-modal-backdrop" id="addCustomerModal" role="dialog" aria-modal="true" aria-labelledby="addCustomerTitle">
        <div class="salon-modal">
            <div class="salon-modal-head">
                <h2 class="salon-modal-title" id="addCustomerTitle">
                    <i class="ti ti-user-plus"></i>
                    <span>Add Customer</span>
                </h2>
                <button type="button" class="salon-modal-close" data-close="addCustomerModal" aria-label="Close modal">
                    <i class="ti ti-x"></i>
                </button>
            </div>
            <p class="salon-modal-sub">Create a new customer profile for booking beauty services.</p>

            <form method="post" action="{{ path('staff_customer_create') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('staff_action') }}">

                <div class="modal-grid">
                    <label>First Name
                        <input class="field" type="text" name="first_name" placeholder="e.g. Jane" required>
                    </label>

                    <label>Last Name
                        <input class="field" type="text" name="last_name" placeholder="e.g. Doe" required>
                    </label>

                    <label class="full-span">Email Address
                        <input class="field" type="email" name="email" placeholder="e.g. jane@salon.com" required>
                    </label>

                    <label class="full-span">Contact Phone
                        <input class="field" type="text" name="phone" placeholder="e.g. +63 917 111 2222">
                    </label>
                </div>

                <div class="salon-modal-foot">
                    <button type="button" class="btn-cancel" data-close="addCustomerModal">Cancel</button>
                    <button type="submit" class="btn-save">
                        <i class="ti ti-user-plus"></i>
                        <span>Add Customer</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Modal 2: View Customer Details #}
    <div class="salon-modal-backdrop" id="viewCustomerModal" role="dialog" aria-modal="true" aria-labelledby="viewCustomerTitle">
        <div class="salon-modal">
            <div class="salon-modal-head">
                <h2 class="salon-modal-title" id="viewCustomerTitle">
                    <i class="ti ti-user"></i>
                    <span>Customer Details</span>
                </h2>
                <button type="button" class="salon-modal-close" data-close="viewCustomerModal" aria-label="Close modal">
                    <i class="ti ti-x"></i>
                </button>
            </div>
            <p class="salon-modal-sub">Overview of client contact details and booking record.</p>

            <table class="view-detail-table">
                <tbody>
                    <tr>
                        <th>Customer #</th>
                        <td id="viewCustId">—</td>
                    </tr>
                    <tr>
                        <th>Full Name</th>
                        <td><strong id="viewCustName">—</strong></td>
                    </tr>
                    <tr>
                        <th>Email Address</th>
                        <td id="viewCustEmail">—</td>
                    </tr>
                    <tr>
                        <th>Contact Phone</th>
                        <td id="viewCustPhone">—</td>
                    </tr>
                    <tr>
                        <th>Total Bookings</th>
                        <td id="viewCustBookings">—</td>
                    </tr>
                </tbody>
            </table>

            <div class="salon-modal-foot">
                <a href="{{ path('staff_appointments') }}" id="viewCustAppointmentsBtn" class="btn-action btn-view" style="padding: 8px 14px;">
                    <i class="ti ti-calendar-event"></i>
                    <span>View Appointments</span>
                </a>
                <button type="button" class="btn-save" id="viewToEditBtn">
                    <i class="ti ti-edit"></i>
                    <span>Edit Profile</span>
                </button>
            </div>
        </div>
    </div>

    {# Modal 3: Edit Customer #}
    <div class="salon-modal-backdrop" id="editCustomerModal" role="dialog" aria-modal="true" aria-labelledby="editCustomerTitle">
        <div class="salon-modal">
            <div class="salon-modal-head">
                <h2 class="salon-modal-title" id="editCustomerTitle">
                    <i class="ti ti-edit"></i>
                    <span>Edit Customer</span>
                </h2>
                <button type="button" class="salon-modal-close" data-close="editCustomerModal" aria-label="Close modal">
                    <i class="ti ti-x"></i>
                </button>
            </div>
            <p class="salon-modal-sub">Update client profile and contact details.</p>

            <form method="post" action="{{ path('staff_customer_update') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('staff_action') }}">
                <input type="hidden" name="customer_id" id="editCustomerId" value="0">

                <div class="modal-grid">
                    <label>First Name
                        <input class="field" type="text" name="first_name" id="editCustomerFirst" required>
                    </label>

                    <label>Last Name
                        <input class="field" type="text" name="last_name" id="editCustomerLast" required>
                    </label>

                    <label class="full-span">Email Address
                        <input class="field" type="email" name="email" id="editCustomerEmail" required>
                    </label>

                    <label class="full-span">Contact Phone
                        <input class="field" type="text" name="phone" id="editCustomerPhone">
                    </label>
                </div>

                <div class="salon-modal-foot">
                    <button type="button" class="btn-cancel" data-close="editCustomerModal">Cancel</button>
                    <button type="submit" class="btn-save">
                        <i class="ti ti-device-floppy"></i>
                        <span>Save Changes</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Modal 4: Delete Customer Confirmation Prompt #}
    <div class="salon-modal-backdrop" id="deleteCustomerModal" role="dialog" aria-modal="true" aria-labelledby="deleteCustomerTitle">
        <div class="salon-modal" style="max-width: 460px;">
            <div class="salon-modal-head">
                <h2 class="salon-modal-title" id="deleteCustomerTitle" style="color: #dc2626;">
                    <i class="ti ti-alert-triangle" style="color: #dc2626;"></i>
                    <span>Confirm Deletion</span>
                </h2>
                <button type="button" class="salon-modal-close" data-close="deleteCustomerModal" aria-label="Close modal">
                    <i class="ti ti-x"></i>
                </button>
            </div>
            <p style="margin: 0 0 12px; color: var(--main-text); font-size: 14px; line-height: 1.5;">
                Are you sure you want to delete customer <strong id="deleteCustName">Client</strong> (<span id="deleteCustEmail">email</span>)?
            </p>
            <p class="muted" style="margin-bottom: 20px;">
                This action is permanent and will remove your customer profile record.
            </p>

            <form method="post" action="{{ path('staff_customer_delete') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('staff_action') }}">
                <input type="hidden" name="customer_id" id="deleteCustomerId" value="0">

                <div class="salon-modal-foot" style="border: 0; padding: 0; margin-top: 0;">
                    <button type="button" class="btn-cancel" data-close="deleteCustomerModal">Cancel</button>
                    <button type="submit" class="btn-save" style="background: #dc2626;">
                        <i class="ti ti-trash"></i>
                        <span>Yes, Delete Customer</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        function openModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.add('is-open');
        }

        function closeModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.remove('is-open');
        }

        document.querySelectorAll('[data-close]').forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-close');
                if (targetId) closeModal(targetId);
            });
        });

        document.querySelectorAll('.salon-modal-backdrop').forEach(backdrop => {
            backdrop.addEventListener('click', (e) => {
                if (e.target === backdrop) backdrop.classList.remove('is-open');
            });
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                document.querySelectorAll('.salon-modal-backdrop.is-open').forEach(m => m.classList.remove('is-open'));
            }
        });

        const addBtn = document.getElementById('openAddCustomerModal');
        if (addBtn) {
            addBtn.addEventListener('click', () => openModal('addCustomerModal'));
        }

        let activeCustomerData = null;

        function populateEditModal(data) {
            document.getElementById('editCustomerId').value = data.id || '0';
            document.getElementById('editCustomerFirst').value = data.first || '';
            document.getElementById('editCustomerLast').value = data.last || '';
            document.getElementById('editCustomerEmail').value = data.email || '';
            document.getElementById('editCustomerPhone').value = data.phone || '';
            openModal('editCustomerModal');
        }

        document.addEventListener('click', (e) => {
            const viewBtn = e.target.closest('.btn-view-customer');
            if (viewBtn) {
                const id = viewBtn.getAttribute('data-id') || '';
                const name = viewBtn.getAttribute('data-name') || '';
                const first = viewBtn.getAttribute('data-first') || '';
                const last = viewBtn.getAttribute('data-last') || '';
                const email = viewBtn.getAttribute('data-email') || '';
                const phone = viewBtn.getAttribute('data-phone') || 'N/A';
                const bookings = viewBtn.getAttribute('data-bookings') || '0';
                const isOwner = viewBtn.getAttribute('data-owner') === '1';

                activeCustomerData = { id, name, first, last, email, phone, isOwner };

                document.getElementById('viewCustId').textContent = 'Customer #' + id;
                document.getElementById('viewCustName').textContent = name;
                document.getElementById('viewCustEmail').textContent = email;
                document.getElementById('viewCustPhone').textContent = phone;
                document.getElementById('viewCustBookings').textContent = bookings + (bookings === '1' ? ' booking' : ' bookings');

                const apptBtn = document.getElementById('viewCustAppointmentsBtn');
                if (apptBtn) {
                    apptBtn.href = "{{ path('staff_appointments') }}?keyword=" + encodeURIComponent(email);
                }

                const viewToEditBtn = document.getElementById('viewToEditBtn');
                if (viewToEditBtn) {
                    viewToEditBtn.style.display = isOwner ? 'inline-flex' : 'none';
                }

                openModal('viewCustomerModal');
                return;
            }

            const editBtn = e.target.closest('.btn-edit-customer');
            if (editBtn) {
                populateEditModal({
                    id: editBtn.getAttribute('data-id'),
                    first: editBtn.getAttribute('data-first'),
                    last: editBtn.getAttribute('data-last'),
                    name: editBtn.getAttribute('data-name'),
                    email: editBtn.getAttribute('data-email'),
                    phone: editBtn.getAttribute('data-phone')
                });
                return;
            }

            const delBtn = e.target.closest('.js-delete-customer-btn');
            if (delBtn) {
                document.getElementById('deleteCustomerId').value = delBtn.getAttribute('data-id') || '0';
                document.getElementById('deleteCustName').textContent = delBtn.getAttribute('data-name') || 'Client';
                document.getElementById('deleteCustEmail').textContent = delBtn.getAttribute('data-email') || '';
                openModal('deleteCustomerModal');
            }
        });

        const viewToEditBtn = document.getElementById('viewToEditBtn');
        if (viewToEditBtn) {
            viewToEditBtn.addEventListener('click', () => {
                closeModal('viewCustomerModal');
                if (activeCustomerData && activeCustomerData.isOwner) {
                    populateEditModal(activeCustomerData);
                }
            });
        }
    });
</script>
{% endblock %}
