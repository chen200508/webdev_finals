{% for type, messages in app.flashes %}
    {% for message in messages %}
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                if (window.showToast) {
                    window.showToast({{ message|json_encode|raw }}, {{ (type == 'error' ? 'error' : 'success')|json_encode|raw }}, 2500);
                }
            });
        </script>
    {% endfor %}
{% endfor %}
