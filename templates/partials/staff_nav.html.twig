<header class="desk-main-head">
    <div class="desk-main-head-left">
        <label for="desk-nav" class="desk-menu" aria-label="Open menu">
            <i class="ti ti-menu-2"></i>
            <span>Menu</span>
        </label>
        <span class="desk-head-eyebrow">Staff Dashboard</span>
    </div>
    <div class="desk-main-head-actions">
        {% if staffMember is defined and staffMember %}
            <span style="font-size: 13px; font-weight: 600; color: var(--main-muted); display: inline-flex; align-items: center; gap: 6px; margin-right: 4px;">
                <i class="ti ti-user" style="color: #C68E00;"></i>
                <span class="staff-header-name">{{ staffMember.first_name }}</span>
            </span>
        {% endif %}
        <button type="button" class="desk-theme" id="switch-theme" aria-label="Toggle theme" title="Toggle theme">
            <i class="ti ti-moon" id="theme-icon"></i>
        </button>
        <a class="desk-logout" href="{{ path('app_logout') }}">
            <i class="ti ti-logout"></i>
            <span>Log out</span>
        </a>
    </div>
</header>

